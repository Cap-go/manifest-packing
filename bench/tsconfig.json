{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": [
    "*.ts",
    "worker-configuration.d.ts",
    "../src/**/*.ts",
    "../fixtures/**/*.ts"
  ]
}
